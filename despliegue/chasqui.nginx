#
# El proxy delante de Chasqui, en el servidor DEL CLIENTE.
#
# Meta EXIGE https con certificado válido para dar de alta un webhook, así que
# esto no es opcional ni siquiera para probar. Sustituya CHATBOT.SUDOMINIO.COM y
# ajuste el puerto si cambió CHASQUI_PUERTO.
#
# Si su servidor usa Caddy, Apache o Traefik en vez de nginx, lo que hace falta
# es exactamente esto y no este archivo:
#   1. terminar TLS;
#   2. pasar la IP de origen en `X-Real-IP`;
#   3. no tocar el cuerpo de la petición del webhook (ver abajo);
#   4. un freno de intentos en POST /api/sesion.
# Las cabeceras de seguridad las pone Chasqui por su cuenta, así que no se
# quedará sin ellas por usar otro proxy.

# Las zonas se definen UNA vez, en el bloque http {} (nginx.conf), no aquí:
#   (o copie `chasqui-zonas.conf` a /etc/nginx/conf.d/, que es lo mismo escrito)
#   limit_req_zone $binary_remote_addr zone=chasqui_login:10m rate=5r/m;
#   limit_req_zone $binary_remote_addr zone=chasqui_panel:10m rate=30r/s;
#   limit_req_zone $binary_remote_addr zone=chasqui_web:10m   rate=2r/s;
#
# NO se tocan las cabeceras de CORS aquí. Las pone Chasqui, que es el único que
# sabe qué sitios están dados de alta; un `add_header Access-Control-*` en el
# proxy las duplicaría —el navegador rechaza una respuesta con la cabecera dos
# veces— y el chat dejaría de cargar sin decir por qué.

# Las cabeceras del proxy van en `chasqui-proxy.conf`, que se instala al lado, y
# NO con el `include proxy_params` que se ve en todos los ejemplos: ese archivo
# lo trae el paquete de Debian y de Ubuntu, y no existe en Fedora, en RHEL ni en
# la imagen oficial de nginx. La plantilla que lo usara fallaría al recargar en
# la mitad de los servidores, y el mensaje —«open() /etc/nginx/proxy_params
# failed»— no le dice a nadie que es cosa de la distribución.

server {
    listen 80;
    server_name CHATBOT.SUDOMINIO.COM;
    # Lo único que se sirve por http es el reto de certbot; lo demás, arriba.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name CHATBOT.SUDOMINIO.COM;

    ssl_certificate     /etc/letsencrypt/live/CHATBOT.SUDOMINIO.COM/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHATBOT.SUDOMINIO.COM/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 429 y no el 503 que nginx pone por defecto. Los dos códigos dicen cosas
    # opuestas: 429 es «vas muy rápido, espera y reintenta» —y toda librería
    # HTTP decente hace backoff sola— mientras que 503 es «el servicio está
    # caído», que dispara alertas y caminos de degradación por un hecho que no
    # ha ocurrido. En el panel además confunde al usuario, que no distingue
    # «me pasé» de «esto está roto».
    #
    # VA AQUÍ, a nivel de `server`, y no repetido en los cuatro `location`:
    # se hereda a todos ellos y es un solo sitio que mantener.
    #
    # LO QUE DECÍA ESTA LÍNEA SOBRE `http{}` ERA FALSO y se corrige: decía que
    # ahí «lo declaran varios vhosts y nginx aborta con directive is duplicate».
    # Medido el 2026-08-18 con su pareja sobre un `nginx -t -c` de usar y tirar:
    # declararla en `http{}` y afinarla en un `server` da sintaxis VÁLIDA —se
    # hereda—; lo que aborta es declararla DOS VECES EN EL MISMO NIVEL. Sigue
    # yendo aquí por otra razón: `http{}` vive en nginx.conf, que en casa del
    # cliente no es nuestro, y este archivo sí.
    limit_req_status 429;

    # Y el 429 sale con `Retry-After`, que hasta hoy no llevaba. Sin él, el
    # navegador o la librería que llame reintenta cuando le parece —casi siempre
    # antes de tiempo— y vuelve a chocar contra el mismo freno.
    error_page 429 = @frenado;

    # Explícito y no por defecto: con `proxy_intercept_errors on` este
    # `error_page` se tragaría también los 429 de la aplicación, que tiene su
    # propio freno por cuenta, y las dos capas serían indistinguibles.
    proxy_intercept_errors off;

    # HSTS va AQUÍ y no en la aplicación: el TLS termina en este proxy, que es
    # quien puede prometer que todo el dominio va por https. Actívela cuando lo
    # esté; es difícil de revertir, porque el navegador lo recuerda.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    server_tokens off;

    # Un webhook de Meta es JSON pequeño y el panel no recibe subidas. Un tope
    # bajo acota el abuso sin estorbar a nadie.
    client_max_body_size 1m;

    # El acceso al panel: 5 intentos por minuto y por IP. Chasqui además tiene su
    # propio freno por cuenta —nginx solo frena una IP, y el ataque repartido
    # entre muchas solo lo para la aplicación—, así que son dos capas distintas y
    # no la misma dos veces.
    location = /api/sesion {
        limit_req zone=chasqui_login burst=3 nodelay;
        # 5 r/m: una ranura se libera cada 12 s. Decirle «1» a quien acaba de
        # agotar el freno de acceso sería invitarlo a chocar once veces más.
        set $reintento 12;
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/chasqui-proxy.conf;
    }

    # LOS WEBHOOKS VAN SIN FRENO, y es una decisión, no un olvido. Meta reintenta
    # EN RÁFAGA cuando algo falla: un límite por minuto convertiría un pico
    # normal —o la recuperación tras un corte— en mensajes de clientes perdidos,
    # y Meta acabaría dando de baja la suscripción. El webhook ya está
    # autenticado por firma HMAC sobre el cuerpo, que es una defensa más fuerte
    # que contar peticiones.
    #
    # Y NO SE TOCA EL CUERPO. La firma se comprueba sobre los bytes que llegaron;
    # cualquier cosa que reserialice o reescriba el JSON la rompe, y entonces
    # NADA funciona sin que nada lo explique. Por eso aquí no hay `sub_filter` ni
    # módulos que reescriban, y el buffering se deja como está.
    location /webhook/ {
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/chasqui-proxy.conf;
    }

    # EL CHAT DE LA WEB. Es la única superficie de Chasqui SIN AUTENTICAR: la
    # abre cualquiera que visite el sitio del cliente. Chasqui ya trae su propio
    # freno de conversaciones nuevas por IP, y este es la otra capa —la que para
    # la avalancha antes de que llegue al proceso—.
    #
    # El límite es generoso a propósito: el widget sondea cada tres segundos
    # mientras el visitante tiene el chat abierto, así que una visita normal hace
    # unas veinte peticiones por minuto. Un límite apretado aquí se ve como un
    # chat que «se queda pensando», y nadie relaciona eso con el nginx.
    location /web/ {
        limit_req zone=chasqui_web burst=40 nodelay;
        set $reintento 1;   # 2 r/s -> 0,5 s; el entero que no miente es 1
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/chasqui-proxy.conf;
    }

    location / {
        limit_req zone=chasqui_panel burst=60 nodelay;
        set $reintento 1;   # 30 r/s
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/chasqui-proxy.conf;
    }

    # El 429 de ESTA capa, con la espera que de verdad corresponde a la zona que
    # mordió. Cada `location` con freno declara su `$reintento` arriba.
    #
    # NO HAY VALOR POR DEFECTO, y es a propósito (directiva 20): si mañana
    # alguien añade un `location` con `limit_req` y olvida el `set`, la cabecera
    # sale AUSENTE en vez de salir con un número inventado. Falta una cabecera,
    # que se nota; no miente, que no se nota.
    #
    # Y LA HSTS SE REPITE: `add_header` no se hereda hacia un nivel que declara
    # los suyos, así que sin esta línea el 429 —y solo el 429— saldría sin ella.
    location @frenado {
        add_header Retry-After $reintento always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        default_type text/plain;
        return 429 "vas muy rapido; reintenta en $reintento segundos\n";
    }
}
